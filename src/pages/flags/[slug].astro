---
import flags from "../../../public/flags.json";
import FlagLayout from "../../layouts/FlagItemLayout.astro";
import TinyColourBox from "../../components/TinyColourBox.astro";

export function getStaticPaths() {
    return flags.map((flag) => {
        return {
            params: { slug: flag.slug },
            props: { flag },
        };
    });
}

const { flag: flag } = Astro.props;
const colourLookups: Record<string, string[]> = {
    red: ["#FF0000", "Red"],
    green: ["#00FF00", "Green"],
    white: ["#FFFFFF", "White"],
    black: ["#000000", "Black"],
    yellow: ["#FFFF00", "Yellow"],
    blue: ["#0000FF", "Blue"],
    orange: ["#FFA500", "Orange"],
    lightBlue: ["#00BFFF", "Light blue"],
};
---

<FlagLayout>
    <h1>{flag.name}</h1>
    <img
        src={`/flag-svgs/${flag.isoAlpha2Name.toLowerCase()}.svg`}
        id="main-flag-image"
        alt={`Flag of ${flag.name}`}
    />
    <table>
        <tr>
            <th scope="row">Aspect Ratio</th>
            <td>
                {flag.dimensions.h}:{flag.dimensions.w}
            </td>
        </tr>
        {flag.mainColours && (
            <tr>
                <th scope="row">Generic Colours</th>
                <td>
                    <ul>
                        {flag.mainColours?.map((colour) => (
                            <li>
                                {colourLookups[colour][1]}{" "}
                                <TinyColourBox
                                    colour={colourLookups[colour][0]}
                                />
                            </li>
                        ))}
                    </ul>
                </td>
            </tr>
        )}
        {flag.notes && (
            <tr>
                <th scope="row">Notes</th>
                <td>{flag.notes}</td>
            </tr>
        )}
    </table>
</FlagLayout>

<style>
    #main-flag-image {
        width: 40%;
    }
</style>
