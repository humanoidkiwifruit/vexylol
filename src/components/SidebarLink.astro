---
interface Props {
    text: string;
    link: string;
}

const { text, link } = Astro.props;
---

<a href={link} id="item-link">
    <div id="item-link-box">
        <h4 style="margin: 0;">{text}</h4>
    </div>
</a>

<style>
    #item-link {
        color: inherit;
        text-decoration: none;
        width: calc(100% - 20px);
        margin: 10px;
        box-sizing: border-box;
    }

    #item-link-box {
        border: 2px solid var(--500);
        border-radius: 10px;
        padding: 10px;
        box-sizing: border-box;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: var(--200);
    }
    #item-link-box:hover {
        background-color: var(--400);
    }
</style>
