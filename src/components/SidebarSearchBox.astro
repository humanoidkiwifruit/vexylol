<div id="container-box">
    <input type="text" placeholder="Search.." id="search-input" />
    <div id="results-container"></div>
</div>
<style>
    #container-box {
        border: 2px solid var(--500);
        border-radius: 10px;
        padding: 0px;
        width: calc(100% - 20px);
        margin: 10px;
        display: flex;
        flex-direction: column;
        background-color: var(--200);
    }
    #search-input {
        width: 100%;
        box-sizing: border-box;
        border-width: 0px;
        border-radius: 10px;
        padding: 10px;
        background-color: var(--100);
    }
    #results-container {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .result-item-link {
    }
    .result-item {
    }
</style>
<script>
    const response = await fetch("/flags.json");
    const flagsjson = await response.json();

    const textInput = document.getElementById(
        "search-input",
    ) as HTMLInputElement;
    const resultsContainer = document.getElementById(
        "results-container",
    ) as HTMLDivElement;

    textInput.addEventListener("input", (event) => {
        updateResults();
    });

    textInput.addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
            window.location.href = "/flags/" + updateResults().slug;
        }
    });

    function updateResults() {
        const searchTerm = textInput.value.toLowerCase();
        if (searchTerm == "") {
            resultsContainer.innerHTML = "";
            return;
        }
        const possible_flags = flagsjson.filter((flag) =>
            flag.name.toLowerCase().includes(searchTerm),
        );
        resultsContainer.innerHTML = possible_flags
            .map(
                (flag) =>
                    `<div class="result-item"><a class="result-item-link" href="/flags/${flag.slug}">${flag.name}</a></div>`,
            )
            .join("");
        return possible_flags[0];
    }
</script>
