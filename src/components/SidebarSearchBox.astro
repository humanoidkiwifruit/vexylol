<div id="container-box">
    <input
        type="text"
        placeholder="Search... (hit the / key)"
        id="search-input"
    />
    <div id="results-container"></div>
</div>
<style>
    #container-box {
        border: 2px solid var(--main-accent-colour);
        border-radius: 10px;
        padding: 0px;
        width: calc(100% - 20px);
        margin: 10px;
        display: flex;
        flex-direction: column;
    }
    #search-input {
        width: 100%;
        box-sizing: border-box;
        border-width: 0px;
        border-radius: 10px;
        padding: 10px;
        background-color: var(--panel-background-colour);
    }
    #results-container {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .result-item-link {
    }
    .result-item {
    }
</style>
<script>
    import type { Flag } from "../types.ts";

    const response = await fetch("/flags.json");
    const flagsjson = await response.json();

    const textInput = document.getElementById(
        "search-input",
    ) as HTMLInputElement;
    const resultsContainer = document.getElementById(
        "results-container",
    ) as HTMLDivElement;

    textInput.addEventListener("input", (event) => {
        updateResults();
    });

    textInput.addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
            window.location.href = "/flags/" + updateResults().slug;
        }
    });

    document.addEventListener("keydown", function (event) {
        if (event.key === "/") {
            event.preventDefault();
            textInput.focus();
        }
    });

    function updateResults() {
        const searchTerm = textInput.value.toLowerCase();
        if (searchTerm == "") {
            emptySearchbox();
            return;
        }
        const possible_flags = flagsjson.filter((flag: Flag) =>
            flag.slug.toLowerCase().includes(searchTerm),
        );
        resultsContainer.innerHTML = possible_flags
            .map(
                (flag: Flag) =>
                    `<div class="result-item"><a class="result-item-link" href="/flags/${flag.slug}">${flag.name}</a></div>`,
            )
            .join("");
        textInput.style.borderBottomLeftRadius = "0px";
        textInput.style.borderBottomRightRadius = "0px";
        return possible_flags[0];
    }
    function emptySearchbox() {
        resultsContainer.innerHTML = "";
        textInput.style.borderBottomLeftRadius = "10px";
        textInput.style.borderBottomRightRadius = "10px";
    }
</script>
