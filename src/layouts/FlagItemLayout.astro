---
import Layout from "./Layout.astro";
import HomeLinkBox from "../components/HomeLinkBox.astro";
import SidebarLink from "../components/SidebarLink.astro";
import SidebarSearchBox from "../components/SidebarSearchBox.astro";
---

<Layout>
    <div id="container">
        <div id="left-sidebar">
            <HomeLinkBox />
            <div style="height: 20px;"></div>
            <!-- Small gap to separate items and home link -->
            <SidebarSearchBox />
            <SidebarLink text="Random flag" , link="/random" />
        </div>
        <div id="right-content">
            <slot />
        </div>
    </div>
</Layout>
<style>
    :root {
        --50: #eff0fe;
        --100: #e1e2fe;
        --200: #c9cafc;
        --300: #a9a8f9;
        --400: #9085f4;
        #home-link {
            color: inherit;
            text-decoration: none;
            width: calc(100% - 20px);
            margin: 10px;
            box-sizing: border-box;
        }

        #home-link-box {
            border: 3px solid var(--700);
            border-radius: 10px;
            padding: 10px;
            box-sizing: border-box;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: var(--200);
        }
        #home-link-box:hover {
            background-color: var(--400);
        }
        --500: #7e68ec;
        --600: #6f4be0;
        --700: #5937b8;
        --800: #4f349f;
        --900: #42317e;
        --950: #281d49;
    }

    #container {
        min-height: 100vh;
        box-sizing: border-box;
        display: flex;
        gap: 20px;
        background-color: var(--200);
        padding: 20px;
    }
    #left-sidebar {
        flex: 0 0 20%;
        display: flex;
        flex-direction: column;
        align-items: center;
        border: 2px solid var(--900);
        background-color: var(--100);
        border-radius: 10px;
    }
    #right-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        border: 2px solid var(--900);
        padding: 10px;
        background-color: var(--100);
        border-radius: 10px;
    }
</style>
