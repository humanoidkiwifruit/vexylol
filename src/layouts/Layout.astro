---
import Layout from "./Layout.astro";
import HomeLinkBox from "../components/HomeLinkBox.astro";
import SidebarLink from "../components/SidebarLink.astro";
import SidebarSearchBox from "../components/SidebarSearchBox.astro";
import "../styles/colours.css";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>vexy.lol</title>
    </head>
    <body>
        <div id="container">
            <div id="left-sidebar">
                <HomeLinkBox />
                <div style="height: 20px;"></div>
                <!-- Small gap to separate items and home link -->
                <SidebarSearchBox />
                <SidebarLink text="Random flag" , link="/random" />
                <SidebarLink
                    text="Github"
                    link="https://github.com/humanoidkiwifruit/vexylol"
                />
                <SidebarLink text="Detailed search" link="/search" />
            </div>
            <div id="right-content">
                <slot />
            </div>
        </div>
    </body>
</html>
<style>
    body {
        padding: 0;
        margin: 0;
        font-family: sans-serif;
    }
    #home-link {
        color: inherit;
        text-decoration: none;
        width: calc(100% - 20px);
        margin: 10px;
        box-sizing: border-box;
    }

    #home-link-box {
        border: 3px solid var(--main-accent-colour);
        border-radius: 10px;
        padding: 10px;
        box-sizing: border-box;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: var(--panel-background);
    }
    #home-link-box:hover {
        background-color: var(--main-accent-colour);
    }
    #container {
        min-height: 100vh;
        box-sizing: border-box;
        display: flex;
        gap: 20px;
        background-color: var(--page-background);
        padding: 20px;
        color: var(--heavy-accent-colour);
    }
    #left-sidebar {
        flex: 0 0 20%;
        display: flex;
        flex-direction: column;
        align-items: center;
        border: 2px solid var(--main-accent-colour);
        background-color: var(--panel-background);
        border-radius: 10px;
    }
    #right-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 10px;
        background-color: var(--panel-background);
        border: 2px solid var(--main-accent-colour);
        border-radius: 10px;
    }
</style>
